<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Platforms>x64</Platforms>
    <!--
      xsd.exe emits a stray `/// <remarks/>` above the namespace in each generated file, which sits on
      no language element and so raises CS1587. Suppressed at the project rather than edited out of the
      generated source, because the file headers say edits are lost on regeneration and the generator
      re-emits it deterministically — a manual fix would need reapplying every time.

      Scoped to this project, which is almost entirely xsd output. The cost is that a genuinely
      misplaced doc comment in the hand-written MzidIdentifications.cs would also go unreported.
    -->
    <NoWarn>$(NoWarn);CS1587</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <DebugType>full</DebugType>
    <DebugSymbols>true</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CsvHelper" Version="32.0.3" />
  </ItemGroup>
  
  <ItemGroup>
    <ProjectReference Include="..\MassSpectrometry\MassSpectrometry.csproj" />
    <ProjectReference Include="..\MzLibUtil\MzLibUtil.csproj" />
  </ItemGroup>

</Project>
