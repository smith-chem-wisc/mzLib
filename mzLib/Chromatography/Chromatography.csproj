<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Deliberately free of heavy dependencies. This project holds the retention time prediction
    abstractions plus the two analytical predictors (SSRCalc3, CZE), which are pure C#. The
    TorchSharp-backed Chronologer predictor lives in Chromatography.Chronologer so that consumers
    which only describe or consume predictors never pay for libtorch. Do not add native or
    ML-runtime package references here.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	<Platforms>x64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MzLibUtil\MzLibUtil.csproj" />
    <ProjectReference Include="..\Omics\Omics.csproj" />
  </ItemGroup>

</Project>
