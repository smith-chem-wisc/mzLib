<Project>

  <PropertyGroup>
    <!-- Audit transitive packages, not just direct ones. Redundant while everything targets
         net10.0, since that is the default from net9.0 on; stated anyway so retargeting a project
         downwards cannot quietly reduce auditing to direct dependencies only. -->
    <NuGetAuditMode>all</NuGetAuditMode>

    <!-- Emit the XML documentation file next to each assembly, and ship it in the package, so that
         consumers get tooltips for mzLib types in their IDE. Roughly 1,900 <summary> blocks already
         exist across the tree and none of them reached anyone outside this repository before now. -->
    <!-- Only for projects that ship. An XML documentation file for a test or benchmark assembly
         serves nobody, and generating it there was surfacing 60 of the 103 doc-comment warnings in
         code no consumer ever sees. -->
    <GenerateDocumentationFile Condition="'$(MSBuildProjectName)' != 'Test' and '$(MSBuildProjectName)' != 'Development'">true</GenerateDocumentationFile>

    <!-- Turning documentation generation on also turns on the doc-comment diagnostics. Two of them
         are suppressed and two are deliberately left visible, on the line between "incomplete" and
         "malformed":
           CS1591 missing XML comment for a public type or member - 248 of 930 public types have none,
                  so this would bury every other warning. Worth filling in, not worth hiding the build.
           CS1573 a parameter has no matching param tag - partial documentation is still useful
                  documentation, and the tooltip renders.
         Left visible, because these mean a comment may not render at all and so defeat the point of
         shipping the file: CS1570 badly formed XML, and CS1587 comment not on a valid language
         element. Roughly 200 of those exist today; the generated XML still parses, so they degrade
         rather than break, but they are real defects worth fixing. -->
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Two moderate infinite-loop DoS advisories in OpenMcdf 2.x, unfixable while Thermo
         CommonCore links 2.x: thermofisherlsms/RawFileReader#22. Suppressed rather than fixed
         because the DoS needs a crafted CFB file and we read trusted local instrument files.
         Here rather than in Readers.csproj because OpenMcdf reaches six projects transitively.
         Watched by .github/workflows/check-thermo-rawfilereader.yml. -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-jxpf-xq2m-q525" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-5qwm-7pvp-w988" />
  </ItemGroup>

</Project>
