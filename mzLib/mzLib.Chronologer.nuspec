<?xml version="1.0"?>
<package>
  <metadata>
    <id>mzLib.Chronologer</id>
    <version>1.0.574</version>
    <title>mzLib.Chronologer</title>
    <authors>Stef S.</authors>
    <owners>Stef S.</owners>
    <license type="expression">LGPL-3.0-or-later</license>
    <projectUrl>https://github.com/smith-chem-wisc/mzLib</projectUrl>
    <icon>images\mzLib.png</icon>
    <description>
      TorchSharp-backed Chronologer deep learning retention time prediction for mzLib.
      Split out of the main mzLib package so that the large libtorch native runtime is an opt-in
      cost: reference mzLib alone for the analytical SSRCalc3 and CZE predictors, and add this
      package only if you need model-based retention time prediction.
    </description>
    <tags>Chemistry Spectrometry RetentionTime Chronologer</tags>
    <dependencies>
      <!--
        The mzLib dependency is pinned to an exact version because Chromatography.Chronologer.dll is
        compiled against a specific Chromatography.dll. Both packages are produced from the same
        release tag, so they always version in lockstep.
      -->
      <group targetFramework="net8.0">
        <dependency id="mzLib" version="[$mzlibversion$]" />
        <dependency id="TorchSharp" version="0.105.1" />
        <dependency id="libtorch-cpu-win-x64" version="2.5.1" />
      </group>
      <group targetFramework="net8.0-windows7.0">
        <dependency id="mzLib" version="[$mzlibversion$]" />
        <dependency id="TorchSharp" version="0.105.1" />
        <dependency id="libtorch-cpu-win-x64" version="2.5.1" />
      </group>
    </dependencies>
  </metadata>
  <files>
    <file src="mzLib.png" target="images\" />
    <file src="Chromatography.Chronologer\bin\x64\Release\net8.0\Chromatography.Chronologer.dll" target="lib\net8.0" />
    <file src="Chromatography.Chronologer\bin\x64\Release\net8.0\Chromatography.Chronologer.dll" target="lib\net8.0-windows7.0" />
  </files>
</package>
