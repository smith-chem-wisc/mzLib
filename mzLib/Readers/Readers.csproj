<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<Platforms>x64</Platforms>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>

	<ItemGroup>
		<!-- Two OpenMcdf advisories, same infinite-loop DoS class, both affecting the 2.x line:
		     GHSA-jxpf-xq2m-q525 / CVE-2026-41511 (fixed in 3.1.3) and
		     GHSA-5qwm-7pvp-w988 / CVE-2026-45785 (fixed in 3.1.4).
		     Neither fix is reachable from here: the Thermo CommonCore binaries are compiled against
		     OpenMcdf 2.x and 3.x is an API-incompatible rewrite, so upgrading breaks .raw reading.
		     Reported to Thermo, forwarded to the CommonCore developers:
		     https://github.com/thermofisherlsms/RawFileReader/issues/22
		     Suppressed by advisory URL, so any new OpenMcdf advisory still surfaces. Remove both once
		     Thermo ships against 3.1.4+. -->
		<NuGetAuditSuppress Include="https://github.com/advisories/GHSA-jxpf-xq2m-q525" />
		<NuGetAuditSuppress Include="https://github.com/advisories/GHSA-5qwm-7pvp-w988" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CsvHelper" Version="32.0.3" />
		<!-- OpenMcdf is intentionally pinned to the 2.x line. DO NOT upgrade to 3.x.
		     The Thermo CommonCore RawFileReader binary is compiled against OpenMcdf 2.x
		     (v8.0.37 targets OpenMcdf 2.3.0); OpenMcdf 3.x is an API-incompatible rewrite
		     that breaks Thermo .raw reading. Thermo's latest release still ships against
		     OpenMcdf 2.x, so there is no 3.x-based option today. GHSA-5qwm-7pvp-w988
		     (fixed in 3.1.4) is a DoS on crafted/untrusted CFB files and does not apply -
		     we only read trusted local instrument files. -->
		<PackageReference Include="OpenMcdf" Version="2.3.1" />
		<PackageReference Include="OpenMcdf.Extensions" Version="2.3.1" />
		<!-- .Core only, not the System.Data.SQLite metapackage. The metapackage adds the EF6 and
		     LINQ-to-Entities providers, which nothing here uses, and they drag in EntityFramework ->
		     System.Data.SqlClient (high severity) -> ... -> System.Drawing.Common 4.7.0 (critical).
		     The provider and native engine live in .Core, so reading is unaffected. -->
		<PackageReference Include="System.Data.SQLite.Core" Version="1.0.118" />
		<PackageReference Include="System.Runtime.InteropServices" Version="4.3.0" />
		<PackageReference Include="TopDownProteomics" Version="0.0.299" />
		<PackageReference Include="ZstdSharp.Port" Version="0.8.7" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\MassSpectrometry\MassSpectrometry.csproj" />
		<ProjectReference Include="..\MzLibUtil\MzLibUtil.csproj" />
		<ProjectReference Include="..\Transcriptomics\Transcriptomics.csproj" />
		<ProjectReference Include="..\UsefulProteomicsDatabases\UsefulProteomicsDatabases.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Reference Include="ThermoFisher.CommonCore.BackgroundSubtraction">
			<HintPath>Thermo\ThermoFisher.CommonCore.BackgroundSubtraction.dll</HintPath>
		</Reference>
		<Reference Include="ThermoFisher.CommonCore.Data">
			<HintPath>Thermo\ThermoFisher.CommonCore.Data.dll</HintPath>
		</Reference>
		<Reference Include="ThermoFisher.CommonCore.MassPrecisionEstimator">
			<HintPath>Thermo\ThermoFisher.CommonCore.MassPrecisionEstimator.dll</HintPath>
		</Reference>
		<Reference Include="ThermoFisher.CommonCore.RawFileReader">
			<HintPath>Thermo\ThermoFisher.CommonCore.RawFileReader.dll</HintPath>
		</Reference>
	</ItemGroup>

	<ItemGroup>
		<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
			<_Parameter1>Test</_Parameter1>
		</AssemblyAttribute>
	</ItemGroup>

	<ItemGroup>
		<!-- Bruker baf2sql native library + its VC++ 2012 runtime dependencies.
		     These live in the project root (not a subfolder) so they copy to the output root
		     and can be resolved by the bare-name DllImport ("baf2sql_c") in BrukerFileReader.
		     baf2sql_c.dll depends on msvcp110/msvcr110/vcomp110, so all four must sit together. -->
		<None Update="baf2sql_c.dll">
		  <CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
		<None Update="Bruker\baf2sql_c.lib">
		  <CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
		<None Update="msvcp110.dll">
		  <CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
		<None Update="msvcr110.dll">
		  <CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
		<None Update="vcomp110.dll">
		  <CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
		<None Update="Thermo\ThermoFisher.CommonCore.BackgroundSubtraction.dll">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
		<None Update="Thermo\ThermoFisher.CommonCore.Data.dll">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
		<None Update="Thermo\ThermoFisher.CommonCore.MassPrecisionEstimator.dll">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
		<None Update="Thermo\ThermoFisher.CommonCore.RawFileReader.dll">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
		<None Update="timsdata.dll">
		  <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="timsdata.lib">
		  <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="timsTOF\baf2sql_c.dll">
		  <CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
		<None Update="timsTOF\baf2sql_c.lib">
		  <CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
	</ItemGroup>

</Project>
